# Copie ce fichier en ".env" puis remplis-le. Ne le publie JAMAIS (mots de passe).
# (./definir-mot-de-passe.sh le cree automatiquement s'il n'existe pas)

# ============================================================
# Interface web (service tracker-web)
# ============================================================

# Le nom de domaine et le HTTPS sont geres par Nginx Proxy Manager (NPM),
# pas ici. tracker-web ecoute en HTTP sur le reseau Docker de NPM.

# Nom du reseau Docker de NPM : "docker network ls", ou
#   docker inspect <conteneur_npm> --format '{{json .NetworkSettings.Networks}}'
PROXY_NETWORK=proxy

# Port de test, accessible UNIQUEMENT depuis le serveur lui-meme
# (curl http://127.0.0.1:8088). A changer seulement s'il est deja pris.
WEB_PORT=8088

# Adresse de l'ESP32 sur le reseau local (reserver cette IP dans la box)
ESP32_URL=http://192.168.1.60

# Identifiant + empreinte du mot de passe : NE PAS remplir a la main,
# lancer ./definir-mot-de-passe.sh
WEB_USER=
WEB_PASSWORD_HASH=

# ============================================================
# Flashage OTA (service tracker-ota)
# ============================================================
OTA_IP=192.168.1.60
# Identique a OTA_PASSWORD dans tracker_web_control54/Secrets.h
OTA_PASSWORD=
# Adresse LAN du serveur qui lance le flashage (pas "localhost")
HOST_IP=192.168.1.77
HOST_PORT=3232
